# Research Copilot — Environment Variables (MVP v0.1)
# Copy to .env before running `docker compose up`.

# --- Secrets ---
# LLM provider API key (Claude / GPT). Optional in dev; required for QA loop.
# LLM_API_KEY=sk-...

# --- Database ---
DATABASE_URL=postgresql://rc:rc@db:5432/research_copilot

# --- Queue ---
REDIS_URL=redis://redis:6379/0

# --- Services ---
GROBID_URL=http://grobid:8070
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=rc
S3_SECRET_KEY=rc_minio_secret

# --- Runtime ---
# LOG_LEVEL=INFO
